// Independent Linux acceptance: the dual-boot Windows node may be offline.
pipeline {
  agent none
  options { disableConcurrentBuilds(); timestamps(); timeout(time: 90, unit: 'MINUTES'); buildDiscarder(logRotator(numToKeepStr: '15')) }
  parameters { string(name: 'SOURCE_PATH', defaultValue: '', description: 'Absolute local source repository path'); string(name: 'SOURCE_SHA', defaultValue: '', description: 'Full immutable 40-character commit SHA'); }
  stages {
    stage('Source snapshot') {
      agent { label 'built-in' }
      steps {
        deleteDir()
        sh '''set -eu
          # Validate parameters before any Git call: no branch names or option-like values.
          case "$SOURCE_SHA" in
            *[!0123456789abcdef]*|'') echo 'SOURCE_SHA must be a full lowercase 40-character commit SHA' >&2; exit 1 ;;
          esac
          test "${#SOURCE_SHA}" -eq 40 || { echo 'SOURCE_SHA must be a full lowercase 40-character commit SHA' >&2; exit 1; }
          case "$SOURCE_PATH" in
            /*) ;;
            *) echo 'SOURCE_PATH must be an absolute path' >&2; exit 1 ;;
          esac
          bootstrap=$(mktemp -d)
          trap 'rm -rf "$bootstrap"' EXIT
          git -C "$SOURCE_PATH" cat-file blob "$SOURCE_SHA:ci/snapshot.py" > "$bootstrap/snapshot.py"
          git -C "$SOURCE_PATH" cat-file blob "$SOURCE_SHA:ci/source_provenance.py" > "$bootstrap/source_provenance.py"
          python3 "$bootstrap/snapshot.py" . --source "$SOURCE_PATH" --sha "$SOURCE_SHA"
        '''
        sh 'python3 ci/run.py source-provenance python3 -m unittest discover -s ci -p test_source_provenance.py'
        sh 'python3 ci/run.py release-acceptance python3 -m unittest discover -s ci -p test_release_acceptance.py'
        sh 'python3 ci/run.py release-publisher python3 -m unittest discover -s ci -p test_publish_signed_release.py'
        stash name: 'source', includes: '**', useDefaultExcludes: false
        archiveArtifacts artifacts: 'source-manifest.json,source-identity.json', fingerprint: true
      }
    }
    stage('Gitleaks + Trivy') {
      agent { label 'built-in' }
      steps { sh 'RTRUST_TOOL_CACHE="$JENKINS_HOME/caches/rtrust-native-tools" python3 ci/run.py security python3 ci/security.py' }
      post { always { junit 'reports/security.xml'; archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true } }
    }
    stage('Linux x86_64 unit, Wayland and network E2E') {
      agent { label 'gaming-amd64' }
      steps {
        deleteDir()
        unstash 'source'
        sh 'python3 ci/run.py linux-x86_64 python3 ci/linux.py'
      }
      post { always { junit allowEmptyResults: true, testResults: 'reports/linux-*.xml'; archiveArtifacts artifacts: 'reports/linux-*,dist/**', allowEmptyArchive: true, fingerprint: true } }
    }
    stage('Flatpak and host packages') {
      agent { label 'gaming-amd64' }
      steps {
        sh '''python3 ci/run.py linux-flatpak python3 scripts/package-flatpak.py --binary-dir dist/native-preview-linux
          python3 ci/run.py linux-host-package python3 scripts/package-linux-host.py --binary dist/service-preview-linux/rtrust-service --pkgrel "$BUILD_NUMBER"
          python3 ci/run.py linux-flatpak-update python3 ci/flatpak_update_e2e.py --repo dist/flatpak-repo
          python3 ci/run.py linux-flatpak-webview python3 scripts/package-flatpak.py --binary-dir dist/native-preview-linux --ui webview --webview-libs dist/webview-libs --repo-dir dist/flatpak-webview-repo
          python3 ci/run.py linux-flatpak-both python3 scripts/package-flatpak.py --binary-dir dist/native-preview-linux --ui both --webview-libs dist/webview-libs --repo-dir dist/flatpak-both-repo
        '''
      }
      post { always { junit allowEmptyResults: true, testResults: 'reports/linux-*.xml'; archiveArtifacts artifacts: 'reports/linux-*,dist/R-TrustTunnel-Linux-*.flatpak*,dist/rtrust-host-*.pkg.tar.*', allowEmptyArchive: true, fingerprint: true } }
    }
  }
}
