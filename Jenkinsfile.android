// Android preview on the Linux/KVM node; no host VPN or route changes.
pipeline {
  agent none
  options { disableConcurrentBuilds(); timestamps(); timeout(time: 90, unit: 'MINUTES'); buildDiscarder(logRotator(numToKeepStr: '15')) }
  parameters { string(name: 'SOURCE_PATH', defaultValue: '', description: 'Absolute local source repository path'); string(name: 'SOURCE_SHA', defaultValue: '', description: 'Full immutable 40-character commit SHA');  string(name: 'ANDROID_EMULATOR', defaultValue: 'emulator-5580', description: 'Already provisioned isolated Android emulator') }
  stages {
    stage('Source snapshot') {
      agent { label 'built-in' }
      steps {
        deleteDir()
        sh '''set -eu
          test -n "$SOURCE_PATH" && test -n "$SOURCE_SHA"
          bootstrap=$(mktemp -d)
          trap 'rm -rf "$bootstrap"' EXIT
          git -C "$SOURCE_PATH" show "$SOURCE_SHA:ci/snapshot.py" > "$bootstrap/snapshot.py"
          git -C "$SOURCE_PATH" show "$SOURCE_SHA:ci/source_provenance.py" > "$bootstrap/source_provenance.py"
          python3 "$bootstrap/snapshot.py" . --source "$SOURCE_PATH" --sha "$SOURCE_SHA"
        '''
        sh 'python3 ci/run.py source-provenance python3 -m unittest discover -s ci -p test_source_provenance.py'
        sh 'python3 ci/run.py release-acceptance python3 -m unittest discover -s ci -p test_release_acceptance.py'
        sh 'python3 ci/run.py release-publisher python3 -m unittest discover -s ci -p test_publish_signed_release.py'
        stash name: 'source', includes: '**', useDefaultExcludes: false
        archiveArtifacts artifacts: 'source-manifest.json,source-identity.json', fingerprint: true
      }
    }
    stage('Gitleaks + Trivy') {
      agent { label 'built-in' }
      steps { sh 'RTRUST_TOOL_CACHE="$JENKINS_HOME/caches/rtrust-native-tools" python3 ci/run.py security python3 ci/security.py' }
      post { always { junit 'reports/security.xml'; archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true } }
    }
    stage('Android JNI, APK, lint and emulator smoke') {
      agent { label 'gaming-amd64' }
      steps {
        deleteDir()
        unstash 'source'
        sh '''export JAVA_HOME="$HOME/.jenkins-agent/jdk"
          export ANDROID_HOME="$HOME/Android/Sdk"
          export GRADLE="$HOME/rtrust-validation/gradle-8.13/bin/gradle"
          python3 ci/run.py android python3 ci/android.py --serial "${ANDROID_EMULATOR:-emulator-5580}"
        '''
      }
      post { always { junit allowEmptyResults: true, testResults: 'reports/android.xml'; archiveArtifacts artifacts: 'reports/android*,dist/android/*,apps/android/app/build/reports/lint-results-*', allowEmptyArchive: true, fingerprint: true } }
    }
  }
}
