<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RTrust" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:alertDialogTheme">@style/Dialog.RTrust</item>
        <item name="android:popupMenuStyle">@style/Popup.RTrust</item>
    </style>
    <style name="Dialog.RTrust" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:windowTitleStyle">@style/DialogTitle.RTrust</item>
    </style>
    <style name="DialogTitle.RTrust" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Popup.RTrust" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@color/surface_raised</item>
    </style>
</resources>
