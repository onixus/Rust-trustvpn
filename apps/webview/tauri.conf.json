{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-TrustTunnel",
  "version": "0.3.2",
  "identifier": "org.rtrusttunnel.Webview",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "R-TrustTunnel",
        "width": 860,
        "height": 620,
        "minWidth": 560,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
